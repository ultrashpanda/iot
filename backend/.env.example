# Copy to .env (never commit .env). Only TTN_API_KEY is required for real nodes.

# TTN console → Applications → soundscape → API keys → Add API key,
# rights "Read application traffic (uplink and downlink)" and, to change the
# uplink interval from the map, "Write downlink application traffic".
TTN_API_KEY=
TTN_APP_ID=soundscape
TTN_MQTT_HOST=eu1.cloud.thethings.network

# Optional
# PORT=8080
# HOST=127.0.0.1           # 0.0.0.0 to open the map from other devices on your network
# SIMULATOR_DEVICES=20     # 0 = only real nodes
# DEFAULT_INTERVAL_MIN=10  # node uplink interval, used for online/offline
# DB_PATH=soundscape.db
# DEVICES_FILE=devices.json
# FRONTEND_DIR=../frontend
